# Copy to .env.
#
# ─── Backend URLs are deliberately absent ────────────────────────────────────
#
# Every API client defaults to a relative path — /api, /orchestrator-api,
# /agents-api, /labs-api — which Vercel rewrites in production and the Vite
# proxy forwards in development. The same path works in both modes, and the
# request stays same-origin either way, so the auth cookie needs no CORS or
# SameSite negotiation.
#
# Nothing below needs setting for either mode to work. See BACKENDS.md for the
# full map of which repository is behind each prefix.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_DEMO_EMAIL=demo@veeragenai.com
VITE_DEMO_PASSWORD=VeeraDemo@2026


# ─── Optional: point one client at a deployed backend ────────────────────────
#
# Useful in development when you would rather not run all four backends
# locally. Uncomment in .env.development (which is gitignored, so it stays
# yours). Note this makes the request cross-origin, so it depends on that
# backend's CORS allowing http://localhost:5173 with credentials.
#
# Do NOT set these for production: a value there bypasses the rewrite, makes the
# request cross-origin, and breaks the auth cookie. Production URLs live in
# vercel.json.
#
#   VITE_CORE_API_URL=https://veeragenaiproject-be.vercel.app
#   VITE_ORCHESTRATOR_API_URL=https://veeragenaiproject-agent-orchestation.fastapicloud.dev
#   VITE_AGENTS_API_URL=https://veeragenaiproject-agents-be.fastapicloud.dev
#   VITE_LABS_API_URL=https://veeragenaiproject-be2.vercel.app
#
# Local ports, for reference (configured in vite.config.js):
#   /api  8000   /labs-api  8001   /orchestrator-api  8003   /agents-api  8004
